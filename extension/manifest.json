{
  "manifest_version": 3,
  "name": "Rust Video Chat Extension",
  "version": "0.1.0",
  "description": "Secure P2P video chat using Rust and WebRTC",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/video_chat_wasm_bg.wasm",
        "content/inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}